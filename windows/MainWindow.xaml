<Window x:Class="AppVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppVPN" Width="440" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Window.Resources>
    <StackPanel Margin="28,28,28,22">
        <Border Width="100" Height="100" CornerRadius="30" HorizontalAlignment="Center" Margin="0,0,0,32"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="Glyph" FontFamily="{StaticResource Icons}" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ProgressBar x:Name="Spinner" IsIndeterminate="True" Width="56" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="Subtitle" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="130" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />

        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
            <Button x:Name="Primary" Padding="18,8" Click="OnPrimary" />
            <Button x:Name="FromUrl" Content="From URL…" Padding="18,8" Margin="10,0,0,0" Click="OnImportUrl" />
            <Button x:Name="ProfileButton" Padding="14,8" Margin="10,0,0,0" MaxWidth="220" Click="OnProfileMenu">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ProfileName" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Margin="0,22,0,0" Padding="20" CornerRadius="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#xE710;" FontFamily="{StaticResource Icons}" Padding="9" Click="OnAddApps"
                            ToolTip="Add apps" AutomationProperties.Name="Add apps" />
                    <TextBlock Text="Apps" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="AppsHint" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <!-- ponytail: fixed row height keeps the window from growing past six apps. -->
                <ScrollViewer x:Name="AppScroll" MaxHeight="312" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="AppList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Height="52" ToolTip="{Binding Help}">
                                    <DockPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Remove from List" Tag="{Binding}" Click="OnRemove" />
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <Button DockPanel.Dock="Right" Content="Launch" VerticalAlignment="Center" Tag="{Binding}" Click="OnLaunch"
                                            IsEnabled="{Binding CanLaunch}" ToolTip="{Binding LaunchHelp}" ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.Name="{Binding LaunchLabel}" />
                                    <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10" Padding="7" Margin="0,0,8,0"
                                            VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Tag="{Binding}" Click="OnRemove"
                                            ToolTip="Remove from list" AutomationProperties.Name="{Binding RemoveLabel}" />
                                    <Image Source="{Binding Icon}" Width="34" Height="34" Margin="0,0,12,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Symbol, Mode=OneWay}" FontFamily="{StaticResource Icons}" Foreground="{Binding Tint}" BaselineAlignment="Center" />
                                            <Run Text="{Binding Summary, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Button x:Name="CopyButton" Content="Copy shell proxy settings" Margin="0,22,0,0" HorizontalAlignment="Left" Click="OnCopyShell"
                ToolTip="Paste into PowerShell to send that shell's commands through the VPN." />
    </StackPanel>
</Window>
